<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <title><%= content_for?(:title) ? "#{content_for(:title)} · Harbor Roast" : "Harbor Roast — small-batch coffee" %></title>
    <meta name="description" content="<%= content_for?(:description) ? content_for(:description) : 'Small-batch roasted coffee, shipped from our roastery. Browse the catalog, build a cart, and check out as a guest.' %>">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "foundation/components/adaptive_navigation" if content_for?(:adaptive_navigation) %>
  </head>

  <body class="<%= content_for?(:body_class) ? content_for(:body_class) : "md-body" %>">
    <header class="md-top-app-bar" role="banner">
      <div class="md-top-app-bar__inner">
        <%= link_to "Harbor Roast", storefront_products_path, class: "md-top-app-bar__brand" %>
        <nav class="md-top-app-bar__actions" aria-label="Store">
          <%= link_to "Shop", storefront_products_path, class: "md-button md-button--text" %>
          <% if user_signed_in? %>
            <%= link_to "My orders", storefront_orders_path, class: "md-button md-button--text" %>
          <% end %>
          <%= link_to "Cart", storefront_cart_path, class: "md-button md-button--tonal", aria: { label: "View cart" } %>
          <% if user_signed_in? %>
            <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "md-button md-button--text" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "md-button md-button--text" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main id="main" class="md-main">
      <%= yield %>
    </main>

    <footer class="md-footer">
      <div class="md-section__inner">
        <p>Harbor Roast — small-batch coffee, roasted and shipped from the roastery.</p>
        <p class="md-body--small">
          <%= link_to "Terms", legal_terms_path %> · <%= link_to "Privacy", legal_privacy_path %>
        </p>
      </div>
    </footer>
  </body>
</html>
