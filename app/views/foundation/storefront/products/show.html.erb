<% title @product.name %>
<% description @product.tasting_notes.presence || truncate(@product.description, length: 160) %>

<section class="md-section" aria-labelledby="product-title">
  <div class="md-section__inner">
    <%= link_to "← Back to shop", storefront_products_path, class: "md-button md-button--text" %>

    <div class="storefront-product-detail">
      <div class="storefront-product-detail__image">
        <%= storefront_product_image(@product, alt: @product.description.presence || @product.name, class_name: "storefront-product-detail__img") %>
      </div>

      <div class="md-stack storefront-product-detail__body">
        <div class="md-stack">
          <p class="md-section__eyebrow"><%= @product.roast_level.titleize %> roast · <%= @product.bag_weight_grams %> g</p>
          <h1 id="product-title"><%= @product.name %></h1>
          <p class="storefront-product-detail__price"><%= storefront_money(@product.price_cents, @product.currency) %></p>
          <% if @product.origin.present? %>
            <p><strong>Origin:</strong> <%= @product.origin %></p>
          <% end %>
          <% if @product.tasting_notes.present? %>
            <p><strong>Tasting notes:</strong> <%= @product.tasting_notes %></p>
          <% end %>
          <p><%= @product.description %></p>
        </div>

        <%= form_with url: storefront_cart_items_path(@product.id), method: :post, class: "md-stack" do %>
          <div class="md-actions">
            <label class="md-field" for="quantity">Quantity</label>
            <input id="quantity" name="quantity" type="number" min="1" max="10" value="1" class="md-field__input storefront-quantity">
            <%= button_tag "Add to cart", class: "md-button md-button--filled", type: "submit" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
